generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PollType {
  CHOICE
  AVAILABILITY
  RANKING
  RATING
}

enum PollTemplate {
  EVENT_DATE
  FEATURE_PRIORITY
  OFFSITE_LOCATION
  WORKSHOP_TOPIC
  CUSTOM
}

enum PollVisibility {
  PUBLIC
  PRIVATE
}

enum ResultsVisibility {
  PUBLIC
  AFTER_VOTE
  AFTER_CLOSE
  OWNER_ONLY
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique @db.Citext
  name               String
  passwordHash       String    @map("password_hash")
  /// Set once the user follows a link sent to their address. Private-poll invites only match verified emails.
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz
  /// Sessions signed in before this are rejected, so a password reset signs out every device.
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz
  /// Poll emails (invites, reminders, results). Account emails (verification, reset) always send.
  emailNotifications Boolean   @default(true) @map("email_notifications")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  polls       Poll[]
  responses   PollResponse[]
  groups      Group[]
  emailTokens EmailToken[]

  @@map("users")
}

model Poll {
  id                   String            @id @default(uuid(7)) @db.Uuid
  creatorId            String            @map("creator_id") @db.Uuid
  slug                 String            @unique
  type                 PollType
  template             PollTemplate      @default(CUSTOM)
  title                String
  description          String?
  /// Type-specific settings, validated by the poll-type registry.
  config               Json              @default("{}")
  closesAt             DateTime?         @map("closes_at") @db.Timestamptz
  closedAt             DateTime?         @map("closed_at") @db.Timestamptz
  allowVoteChange      Boolean           @default(true) @map("allow_vote_change")
  isAnonymous          Boolean           @default(false) @map("is_anonymous")
  requireLogin         Boolean           @default(false) @map("require_login")
  resultsVisibility    ResultsVisibility @default(PUBLIC) @map("results_visibility")
  /// PRIVATE polls are open only to the creator, direct invites and members of linked groups.
  visibility           PollVisibility    @default(PUBLIC)
  expectedParticipants Int?              @map("expected_participants")
  /// Last manual "remind people who haven't voted", for the cooldown.
  remindedAt           DateTime?         @map("reminded_at") @db.Timestamptz
  /// The automatic reminder before the deadline. Cleared when the deadline moves.
  autoRemindedAt       DateTime?         @map("auto_reminded_at") @db.Timestamptz
  /// Archived polls are closed, read-only and kept off the owner's main lists. Unarchive to reopen or edit.
  archivedAt           DateTime?         @map("archived_at") @db.Timestamptz
  /// The "poll closed" email. Cleared on reopen, so closing again sends fresh results.
  resultsEmailedAt     DateTime?         @map("results_emailed_at") @db.Timestamptz
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  creator      User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  options      PollOption[]
  responses    PollResponse[]
  invites      PollInvite[]
  groups       PollGroup[]
  inviteEmails PollInviteEmail[]

  @@index([creatorId, createdAt(sort: Desc)])
  @@index([creatorId, archivedAt])
  @@map("polls")
}

model PollOption {
  id        String    @id @default(uuid(7)) @db.Uuid
  pollId    String    @map("poll_id") @db.Uuid
  label     String
  position  Int
  /// Only set for AVAILABILITY slots.
  startsAt  DateTime? @map("starts_at") @db.Timestamptz
  endsAt    DateTime? @map("ends_at") @db.Timestamptz
  /// Compared with a response's updatedAt to spot options added after someone voted.
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  poll    Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([pollId, position])
  @@map("poll_options")
}

model PollResponse {
  id         String   @id @default(uuid(7)) @db.Uuid
  pollId     String   @map("poll_id") @db.Uuid
  /// Anonymous per-browser identity from the voter_token cookie.
  voterToken String   @map("voter_token")
  voterName  String?  @map("voter_name")
  comment    String?
  userId     String?  @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  poll    Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers Answer[]

  // One response per browser and per signed-in user. NULL user ids are
  // distinct in Postgres, so guests are only constrained by voter_token.
  @@unique([pollId, voterToken])
  @@unique([pollId, userId])
  @@index([pollId, createdAt])
  @@map("responses")
}

/// value meaning depends on poll type: CHOICE 1 = selected, AVAILABILITY 2/1/0 =
/// yes/if need be/no, RANKING = rank (1 is best), RATING = score.
model Answer {
  responseId String @map("response_id") @db.Uuid
  optionId   String @map("option_id") @db.Uuid
  value      Int

  response PollResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  option   PollOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([responseId, optionId])
  @@index([optionId])
  @@map("answers")
}

/// Access to a private poll, by email so people can be invited before they sign up.
model PollInvite {
  id        String   @id @default(uuid(7)) @db.Uuid
  pollId    String   @map("poll_id") @db.Uuid
  email     String   @db.Citext
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, email])
  @@index([email])
  @@map("poll_invites")
}

/// A creator's saved list of people. Only its owner ever sees it.
model Group {
  id        String   @id @default(uuid(7)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  polls   PollGroup[]

  @@unique([ownerId, name])
  @@index([ownerId, createdAt(sort: Desc)])
  @@map("groups")
}

model GroupMember {
  groupId   String   @map("group_id") @db.Uuid
  email     String   @db.Citext
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, email])
  @@index([email])
  @@map("group_members")
}

/// A group shared with a poll. Live: membership changes apply to the poll straight away.
model PollGroup {
  pollId    String   @map("poll_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  poll  Poll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([pollId, groupId])
  @@index([groupId])
  @@map("poll_groups")
}

/// Addresses already emailed about a poll invite, so direct invites and groups never email someone twice.
model PollInviteEmail {
  pollId    String   @map("poll_id") @db.Uuid
  email     String   @db.Citext
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@id([pollId, email])
  @@map("poll_invite_emails")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Single-use link tokens. Only a SHA-256 hash is stored; the raw token lives in the email.
model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz
  usedAt    DateTime?         @map("used_at") @db.Timestamptz
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}
