# Postgres (native install). Create DBs with `createdb -T template0 <name>`.
DATABASE_URL="postgresql://postgres@localhost:5432/poller_dev"
SHADOW_DATABASE_URL="postgresql://postgres@localhost:5432/poller_shadow"
DATABASE_URL_TEST="postgresql://postgres@localhost:5432/poller_test"

# Redis (native install). Used only for rate limiting; the app fails open without it.
REDIS_URL="redis://localhost:6379"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL used to build share links
APP_URL="http://localhost:3000"

# Email via Resend (https://resend.com). Without an API key, emails are printed
# to the server console instead, so links still work in local development.
RESEND_API_KEY=""
# Must be an address on a domain you've verified in Resend.
EMAIL_FROM="Poller <poller@example.com>"

# Protects /api/cron/emails (automatic reminders and results emails).
# Generate with: openssl rand -base64 32
CRON_SECRET=""
